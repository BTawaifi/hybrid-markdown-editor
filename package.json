{
  "name": "hybrid-markdown-editor",
  "version": "1.0.0",
  "description": "Obsidian-like hybrid markdown editor (per-line renderer + inline editing) for React.",
  "license": "MIT",
  "author": "Boutros Tawaifi",
  "repository": {
    "type": "git",
    "url": "https://github.com/BTawaifi/hybrid-markdown-editor"
  },
  "keywords": [
    "markdown",
    "editor",
    "react",
    "obsidian",
    "hybrid"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-textarea-autosize": ">=8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-textarea-autosize": "^8.5.9",
    "rimraf": "^6.1.3",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0"
  }
}
